# GE_Sky API - Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ge_sky

# JWT Secrets (REQUIRED - app will not start without these)
JWT_ACCESS_SECRET=change-me-in-production-use-openssl-rand-base64-32
JWT_REFRESH_SECRET=change-me-another-random-string

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Server
PORT=4000
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Monitoring
SENTRY_DSN_API=

# Search
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Shipping
DHL_API_KEY=
DHL_API_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Two-Factor Auth (optional)
TWO_FACTOR_ISSUER=GE_Sky